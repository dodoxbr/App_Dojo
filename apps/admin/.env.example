NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=SET_LOCAL_ANON_KEY
# Local key: run `npx supabase status` and copy the anon/publishable key into apps/admin/.env.local.
# Never put service_role in public env vars.
# Company that runs the platform (shown in the terms; server-only; leave empty until it exists, the page shows "a definir").
PLATFORM_LEGAL_NAME=
PLATFORM_CNPJ=
